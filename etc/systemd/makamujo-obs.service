[Unit]
Description=Makamujo OBS Studio (Flatpak)
# The browser source loads the overlay page from the broadcasting server, so
# the server has to be serving it before OBS opens the source. Without the
# ordering OBS may start first; the browser source then keeps its "cannot
# connect" page (it is never reloaded: `restart_when_active` is false), and
# the delivered picture loses the overlay — the heartbeat band included — for
# the rest of the run.
After=makamujo-xvfb.service makamujo-pipewire.service makamujo-screen.service
Requires=makamujo-pipewire.service
# `Wants=` and not `Requires=`: systemd propagates an explicit restart of a
# required unit to the requiring unit, and the recovery ladder
# (composition/broadcastFreezeWatchdog.ts) restarts `makamujo-screen.service`
# on its own schedule. The ordering is what matters here, not the coupling.
Wants=makamujo-xvfb.service makamujo-screen.service
PartOf=makamujo-pipewire.service

[Service]
Type=simple
WorkingDirectory=/opt/src/makamujo
User=root
Environment=PATH=/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=DISPLAY=:10
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=PULSE_SERVER=unix:/run/user/0/pulse/native
Environment=PULSE_RUNTIME_PATH=/run/user/0/pulse
Environment=XDG_CONFIG_HOME=/opt/src/makamujo
Environment=XDG_DATA_HOME=/opt/src/makamujo
Environment=XDG_CACHE_HOME=/opt/src/makamujo/.cache
Environment=LIBGL_ALWAYS_SOFTWARE=1
Environment=OBS_BROWSER_HW_ACCEL=0
Environment=OBS_USE_EGL=0
Environment=QT_OPENGL=software
ExecStart=/opt/src/makamujo/bin/x/obs
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
MemoryAccounting=yes
# This cgroup holds the OBS process, the x264 encoder and the CEF subprocess
# of the browser source (the overlay page) at once: `KillMode=control-group`
# keeps them together, so the memory limits below bound all of them.
#
# 32M/256M was far below what that actually needs. The kernel starts
# reclaiming and throttling at `MemoryHigh`, and the encoder then re-encodes
# the same picture over and over, while the CEF renderer is the first victim
# of the pressure: the browser source keeps its last frame and the delivered
# picture loses the overlay (the heartbeat band included) even though the
# game is still moving. The game browser unit (`makamujo-browser.service`)
# runs a whole Chromium with 1G/1.5G; give OBS the same headroom.
MemoryHigh=1G
MemoryMax=1.5G
CPUAccounting=yes
CPUQuota=200%
TasksMax=256
OOMPolicy=continue
OOMScoreAdjust=-1000

[Install]
WantedBy=multi-user.target
