[Unit]
Description=Makamujo screen server (bun start)
After=makamujo-xvfb.service makamujo-pipewire.service
# Requires= propagates an explicit restart: `systemctl restart
# makamujo-xvfb.service` would restart this unit too, killing the composite
# freeze watchdog that runs inside this unit mid-rung and skipping the rest
# of the recovery (see composition/broadcastFreezeWatchdog.ts). Wants= keeps
# the display pulled in and ordered but leaves its restarts one-way.
Wants=makamujo-xvfb.service
Requires=makamujo-pipewire.service
PartOf=makamujo-pipewire.service

[Service]
Type=simple
WorkingDirectory=/opt/src/makamujo
User=root
Environment=PATH=/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=DISPLAY=:10
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=PULSE_SERVER=unix:/run/user/0/pulse/native
Environment=PULSE_RUNTIME_PATH=/run/user/0/pulse
ExecStart=/root/.bun/bin/bun start
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target