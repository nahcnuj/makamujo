[Unit]
Description=Makamujo PipeWire stack for headless streaming
After=network.target makamujo-xvfb.service
Wants=makamujo-xvfb.service
# Restarting every 5s forever only buries the real cause under a wall of
# identical log lines. Five tries in five minutes is enough to clear a
# transient fault and still settles into `failed` for a broken stack.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=all
TimeoutStartSec=90
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=HOME=/root
Environment=DISPLAY=:10
Environment=PULSE_RUNTIME_PATH=/run/user/0/pulse
Environment=PIPEWIRE_RUNTIME_DIR=/run/user/0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus
ExecStartPre=/bin/mkdir -p /run/user/0/pulse
ExecStartPre=/bin/chmod 700 /run/user/0
ExecStart=/usr/local/bin/makamujo-pipewire
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target