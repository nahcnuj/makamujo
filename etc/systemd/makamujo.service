[Unit]
Description=makamujo service
After=graphical.target makamujo-xvfb.service makamujo-pipewire.service
Wants=graphical.target makamujo-xvfb.service makamujo-pipewire.service makamujo-screen.service makamujo-browser.service makamujo-obs.service
PartOf=graphical.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/src/makamujo
User=root
Environment=PATH=/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=DISPLAY=:10
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=PULSE_SERVER=unix:/run/user/0/pulse/native
ExecStart=/bin/true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target