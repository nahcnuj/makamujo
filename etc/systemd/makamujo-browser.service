[Unit]
Description=makamujo browser service
After=makamujo-screen.service makamujo-pipewire.service
Requires=makamujo-pipewire.service
PartOf=makamujo-pipewire.service

[Service]
Type=simple
WorkingDirectory=/opt/src/makamujo
User=root
Environment=PATH=/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=DISPLAY=:10
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=PULSE_SERVER=unix:/run/user/0/pulse/native
Environment=PULSE_RUNTIME_PATH=/run/user/0/pulse
ExecStart=/bin/sh -lc "cd '/opt/src/makamujo' && NODE_ENV=production /root/.bun/bin/bun '/opt/src/makamujo/bin/x/browser.ts'"
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5s
MemoryAccounting=yes
MemoryHigh=1G
MemoryMax=1.5G
CPUAccounting=yes
# Keep enough headroom for the software-rendered game (three cores), but let
# OBS win when both compete: a lower CPUWeight and a higher nice value than
# makamujo-obs.service. CPUQuota is a cap, so spare cores remain usable.
CPUQuota=300%
CPUWeight=500
Nice=-5
TasksMax=512

[Install]
WantedBy=multi-user.target
