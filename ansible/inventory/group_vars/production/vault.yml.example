---
# Copy to vault.yml and encrypt (from ansible/):
#   cp inventory/group_vars/production/vault.yml.example inventory/group_vars/production/vault.yml
#   ansible-vault encrypt inventory/group_vars/production/vault.yml
#
# Or create interactively:
#   ansible-vault create inventory/group_vars/production/vault.yml
#
# Do not commit a plaintext vault.yml.

# Niconama RTMP stream key (番組ごとに変わる場合は edit して playbook 再実行)
niconama_stream_key: "PASTE_STREAM_KEY_HERE"
