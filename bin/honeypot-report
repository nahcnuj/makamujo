#!/usr/bin/env bash
set -euo pipefail

# Report how long each IP caught by the ssh honeypot was served before the
# fail2ban BAN cut it off, derived from the [sshd] jail log.
#
# "caught seconds" = BAN time - first received SSH request time. The request
# time is the timestamp embedded in the earliest fail2ban "Found" event for
# the IP (the sshd log line that tripped the filter); the BAN time is the
# fail2ban log timestamp of the "Ban" event. When LoginGraceTime 0 holds a
# session open, every further auth attempt keeps producing events, so the
# last_seen column shows how long it kept knocking after being dropped.
#
# Usage:
#   bin/honeypot-report [LOG_FILE | -]
#
# With no argument the script reads /var/log/fail2ban.log when present and
# otherwise falls back to `journalctl -u fail2ban`. Pass '-' to read from
# stdin, e.g.:
#   journalctl -u fail2ban | bin/honeypot-report -

usage() {
  sed -n '2,17p' "$0"
  exit 2
}

if [ $# -gt 1 ]; then
  usage
fi

input="${1:-}"
stdin_mode=0
if [ -z "${input}" ]; then
  if [ -r /var/log/fail2ban.log ]; then
    input=/var/log/fail2ban.log
  else
    stdin_mode=1
  fi
fi
if [ "${input}" = "-" ]; then
  stdin_mode=1
fi

declare -A first_epoch ban_epoch last_epoch first_label ban_label last_label

add_first() {
  local ip=$1 epoch=$2 label=$3
  if [ -z "${first_epoch[$ip]:-}" ] || [ "${epoch}" -lt "${first_epoch[$ip]}" ]; then
    first_epoch[$ip]=${epoch}
    first_label[$ip]=${label}
  fi
}

add_last() {
  local ip=$1 epoch=$2 label=$3
  if [ -z "${last_epoch[$ip]:-}" ] || [ "${epoch}" -gt "${last_epoch[$ip]}" ]; then
    last_epoch[$ip]=${epoch}
    last_label[$ip]=${label}
  fi
}

iso_ts='[0-9]{4}-[0-9]{2}-[0-9]{2}[ T][0-9]{2}:[0-9]{2}:[0-9]{2}'
syslog_ts='[A-Z][a-z]{2} [ 0-9][0-9] [0-9]{2}:[0-9]{2}:[0-9]{2}'
ts_re="(${iso_ts}|${syslog_ts})"

process_log() {
  local line line_ts
  while IFS= read -r line || [ -n "${line}" ]; do
    line=${line%$'\r'}
    case ${line} in
      *'[sshd]'*) ;;
      *) continue ;;
    esac

    line_ts=""
    if [[ ${line} =~ ${ts_re} ]]; then
      line_ts=${BASH_REMATCH[1]}
    fi
    [ -n "${line_ts}" ] || continue

    local event ip
    event=""
    ip=""
    ban_re='Ban[ ]+([0-9a-fA-F.:]+)'
    found_re='Found[ ]+([0-9a-fA-F.:]+)'
    again_re='([0-9a-fA-F.:]+)[ ]+already[ ]+banned'
    if [[ ${line} =~ ${ban_re} ]]; then
      event=ban
      ip=${BASH_REMATCH[1]}
    elif [[ ${line} =~ ${found_re} ]]; then
      event=found
      ip=${BASH_REMATCH[1]}
    elif [[ ${line} =~ ${again_re} ]]; then
      event=again
      ip=${BASH_REMATCH[1]}
    else
      continue
    fi

    local trace_ts
    trace_ts="${line_ts}"
    trail_re="-[ ]+(${iso_ts})"
    if [ "${event}" = found ] && [[ ${line} =~ ${trail_re} ]]; then
      trace_ts=${BASH_REMATCH[1]}
    fi

    local epoch
    if ! epoch=$(date -d "${trace_ts//T/ }" +%s 2>/dev/null); then
      continue
    fi

    add_first "${ip}" "${epoch}" "${trace_ts}"
    add_last "${ip}" "${epoch}" "${trace_ts}"
    if [ "${event}" = ban ]; then
      ban_epoch[$ip]=${epoch}
      ban_label[$ip]=${line_ts}
    fi
  done
}

if [ "${stdin_mode}" = 1 ]; then
  process_log
else
  process_log <"${input}"
fi

ips=$(printf '%s\n' "${!ban_epoch[@]}" | sort -V)
if [ -z "${ips}" ]; then
  echo "no banned IPs found in the fail2ban [sshd] log" >&2
  exit 1
fi

printf '%-18s %-19s %-19s %-19s %s\n' \
  IP first_seen last_seen banned_at caught_s
for ip in ${ips}; do
  caught=$((ban_epoch[$ip] - first_epoch[$ip]))
  printf '%-18s %-19s %-19s %-19s %s\n' \
    "${ip}" \
    "${first_label[$ip]}" \
    "${last_label[$ip]}" \
    "${ban_label[$ip]}" \
    "${caught}"
done