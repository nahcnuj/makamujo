#!/usr/bin/env sh

set -eu

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PROJECT_ROOT=$(cd "${SCRIPT_DIR}/.." && pwd)

PID_DIR="${PROJECT_ROOT}/var/pid"
mkdir -p "${PID_DIR}"

cd "${PROJECT_ROOT}"

# Streaming display (makamujo-xvfb)
export DISPLAY=:10

# Headless PipeWire (makamujo-pipewire.service / Ansible)
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/0}"
export PULSE_SERVER="${PULSE_SERVER:-unix:/run/user/0/pulse/native}"

# Wait for headless PipeWire (makamujo-pipewire.service)
echo "Waiting for PipeWire pulse socket..."
_wait_count=0
while [ "$_wait_count" -lt 40 ]; do
  if [ -S "${XDG_RUNTIME_DIR}/pulse/native" ]; then
    echo "PipeWire ready."
    break
  fi
  sleep 0.25
  _wait_count=$((_wait_count + 1))
done
if [ ! -S "${XDG_RUNTIME_DIR}/pulse/native" ]; then
  echo "WARNING: pulse socket not found after wait. Voice may fail." >&2
fi

# Soften OBS Browser Source (CEF) on GPU-less VPS
export LIBGL_ALWAYS_SOFTWARE=1
export OBS_BROWSER_HW_ACCEL=0

nohup bun start >"${PROJECT_ROOT}/var/screen.log" 2>&1 &
echo $! > "${PID_DIR}/screen"

nohup bun ./bin/x/browser.ts >"${PROJECT_ROOT}/var/browser.log" 2>&1 &
echo $! > "${PID_DIR}/browser"

# Comment overlay (left). Game browser stays on the right.
# nohup bun ./bin/x/overlay.ts >"${PROJECT_ROOT}/var/overlay.log" 2>&1 &
# echo $! > "${PID_DIR}/overlay"

# Headless portal stub (avoids ~100s D-Bus timeouts in Flatpak OBS)
if ! pgrep -f "bin/x/portal-stub.py" >/dev/null 2>&1; then
  nohup python3 "${SCRIPT_DIR}/x/portal-stub.py" >"${PROJECT_ROOT}/var/portal-stub.log" 2>&1 &
  echo $! > "${PID_DIR}/portal-stub"
  sleep 0.3
fi

nohup ./bin/x/obs >"${PROJECT_ROOT}/var/obs.log" 2>&1 &
echo $! > "${PID_DIR}/obs"

# After OBS starts, raise main window on :10 for RDP monitoring
(
  sleep 8
  export DISPLAY=:10
  OBS_WIN=$(xwininfo -root -tree 2>/dev/null | grep -oE '0x[0-9a-f]+ "OBS 32[^"]*"' | head -1 | awk '{print $1}' || true)
  if [ -n "$OBS_WIN" ]; then
    xdotool windowactivate "$OBS_WIN" 2>/dev/null || true
    xdotool windowraise "$OBS_WIN" 2>/dev/null || true
    xdotool windowmove "$OBS_WIN" 0 780 2>/dev/null || true
    xdotool windowsize "$OBS_WIN" 1280 640 2>/dev/null || true
  fi
) >/dev/null 2>&1 &
