#!/usr/bin/env sh

set -eu

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PROJECT_ROOT=$(cd "${SCRIPT_DIR}/.." && pwd)

PID_DIR="${PROJECT_ROOT}/var/pid"

# Bun lives outside the default PATH of non-login shells (ansible ad-hoc, nohup).
export PATH="${HOME}/.bun/bin:/root/.bun/bin:${PATH}"

wait_until_process_exits() {
  pid=$1
  retries=0
  while kill -0 "$pid" 2>/dev/null; do
    retries=$((retries + 1))
    if [ "$retries" -ge 50 ]; then
      break
    fi
    sleep 0.1
  done
}

kill_tree() {
  children=$(pgrep -P "$1" 2>/dev/null || true)
  for child_pid in $children; do
    kill_tree "$child_pid"
  done
  kill -KILL -- "-$1" 2>/dev/null || true
  kill -KILL "$1" 2>/dev/null || true
  wait_until_process_exits "$1"
}

# Leftovers: Flatpak OBS often shows as "obs --startstreaming ..." without
# the project path or app id in cmdline. Match makamujo-specific flags.
sweep_leftovers() {
  pkill -TERM -f "${PROJECT_ROOT}/bin/x/obs" 2>/dev/null || true
  pkill -TERM -f "${PROJECT_ROOT}/bin/x/portal-stub" 2>/dev/null || true
  pkill -TERM -f "${PROJECT_ROOT}/bin/x/browser" 2>/dev/null || true
  pkill -TERM -f "${PROJECT_ROOT}/bin/x/overlay" 2>/dev/null || true
  pkill -TERM -f 'obs --startstreaming' 2>/dev/null || true
  pkill -TERM -f 'bwrap.*-- obs --startstreaming' 2>/dev/null || true
  pkill -TERM -f 'flatpak.*com\.obsproject\.Studio' 2>/dev/null || true
  sleep 0.5
  pkill -KILL -f "${PROJECT_ROOT}/bin/x/obs" 2>/dev/null || true
  pkill -KILL -f "${PROJECT_ROOT}/bin/x/portal-stub" 2>/dev/null || true
  pkill -KILL -f "${PROJECT_ROOT}/bin/x/browser" 2>/dev/null || true
  pkill -KILL -f "${PROJECT_ROOT}/bin/x/overlay" 2>/dev/null || true
  pkill -KILL -f 'obs --startstreaming' 2>/dev/null || true
  pkill -KILL -f 'bwrap.*-- obs --startstreaming' 2>/dev/null || true
  pkill -KILL -f 'flatpak.*com\.obsproject\.Studio' 2>/dev/null || true
}

systemctl stop makamujo-obs.service 2>/dev/null || true
systemctl stop makamujo-browser.service 2>/dev/null || true
systemctl stop makamujo-screen.service 2>/dev/null || true

# Intentional stop should not look like a crash on next OBS launch.
clear_obs_sentinel() {
  rm -rf "${HOME}/.var/app/com.obsproject.Studio/config/obs-studio/.sentinel" 2>/dev/null || true
  rm -rf "${PROJECT_ROOT}/obs-studio/.sentinel" 2>/dev/null || true
}

# A SIGKILLed Chromium never removes its profile, and the OS temp dir is only
# 2 GB on the VPS. Now that every browser process is gone, drop the scratch
# directories they left behind. bin/cleanup-temp only touches the browser-owned
# prefixes, so the running server's own scratch dir is kept.
sweep_temporary_directories() {
  if ! command -v bun >/dev/null 2>&1; then
    echo "WARNING: bun not found; stale temp directories were left behind" >&2
    return 0
  fi
  bun "${PROJECT_ROOT}/bin/cleanup-temp.ts" "${TMPDIR:-/tmp}" || true
}




for pid_file in "${PID_DIR}/obs" "${PID_DIR}/browser" "${PID_DIR}/portal-stub" "${PID_DIR}/overlay" "${PID_DIR}/screen"; do
  if [ -f "$pid_file" ]; then
    pid=$(cat "$pid_file")
    if [ -n "$pid" ]; then
      kill_tree "$pid"
    fi
    rm -f "$pid_file"
  fi
done

sweep_leftovers
clear_obs_sentinel
sweep_temporary_directories
