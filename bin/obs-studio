#!/usr/bin/env sh

set -eu

SCRIPT_PATH=$(cd "$(dirname "$0")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_PATH/.." && pwd)

OBS_CONFIG_DIR="$REPO_ROOT/obs-studio"
OBS_CACHE_DIR="$REPO_ROOT/.cache"
SERVICE_JSON="$OBS_CONFIG_DIR/basic/profiles/Makamujo/service.json"
# Ansible Vault playbook installs the key here (see ansible/playbooks/0_secrets.yml).
NICONAMA_STREAM_KEY_FILE="${NICONAMA_STREAM_KEY_FILE:-/etc/makamujo/niconama.stream.key}"

if [ ! -d "$OBS_CONFIG_DIR" ]; then
  echo "OBS config directory not found: $OBS_CONFIG_DIR" >&2
  exit 1
fi

if [ ! -f "$OBS_CONFIG_DIR/basic/profiles/Makamujo/basic.ini" ]; then
  echo "OBS basic.ini not found: $OBS_CONFIG_DIR/basic/profiles/Makamujo/basic.ini" >&2
  exit 1
fi

# Inject Niconama RTMP key into service.json without storing the key in git.
# Prefer python3 (stdlib json); fall back to leaving the file unchanged.
if [ -f "$NICONAMA_STREAM_KEY_FILE" ] && [ -f "$SERVICE_JSON" ]; then
  if command -v python3 >/dev/null 2>&1; then
    if ! python3 - "$NICONAMA_STREAM_KEY_FILE" "$SERVICE_JSON" <<'PY'
import json, pathlib, sys
key_path, service_path = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
key = key_path.read_text(encoding="utf-8").strip()
if not key:
    sys.exit(0)
data = json.loads(service_path.read_text(encoding="utf-8"))
settings = data.setdefault("settings", {})
if settings.get("key") == key:
    sys.exit(0)
settings["key"] = key
service_path.write_text(json.dumps(data, ensure_ascii=False, separators=(",", ":")), encoding="utf-8")
print("[INFO] injected niconama stream key into OBS service.json", file=sys.stderr)
PY
    then
      echo "[WARN] failed to inject stream key into service.json" >&2
    fi
  else
    echo "[WARN] python3 not found; cannot inject stream key from $NICONAMA_STREAM_KEY_FILE" >&2
  fi
fi

FLATPAK_OBS_CONFIG="${HOME}/.var/app/com.obsproject.Studio/config"
mkdir -p "$FLATPAK_OBS_CONFIG"
if [ -e "$FLATPAK_OBS_CONFIG/obs-studio" ] && [ ! -L "$FLATPAK_OBS_CONFIG/obs-studio" ]; then
  rm -rf "$FLATPAK_OBS_CONFIG/obs-studio"
fi
ln -sfn "$OBS_CONFIG_DIR" "$FLATPAK_OBS_CONFIG/obs-studio"

mkdir -p "$OBS_CACHE_DIR"

flatpak run -vv \
    --share=network \
    --filesystem="$REPO_ROOT" \
    --filesystem="$OBS_CONFIG_DIR" \
    --filesystem="$OBS_CACHE_DIR" \
    --env=XDG_CONFIG_HOME="$REPO_ROOT" \
    --env=XDG_DATA_HOME="$REPO_ROOT" \
    --env=XDG_CACHE_HOME="$OBS_CACHE_DIR" \
    --env=LIBGL_ALWAYS_SOFTWARE=1 \
    --env=GALLIUM_DRIVER=llvmpipe \
    --env=MESA_LOADER_DRIVER_OVERRIDE=llvmpipe \
    --env=OBS_BROWSER_HW_ACCEL=0 \
    --env=OBS_USE_EGL=0 \
    --env=QT_QUICK_BACKEND=software \
    --nosocket=wayland \
    com.obsproject.Studio \
    "$@"
