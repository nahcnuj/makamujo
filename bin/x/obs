#!/usr/bin/env sh

set -eu

SCRIPT_PATH=$(dirname "$0")
OBS_STUDIO="${SCRIPT_PATH}/../obs-studio"

_DISPLAY_EXPLICIT=''
_XAUTHORITY_EXPLICIT=''

while [ $# -gt 0 ]; do
  case "$1" in
    --display)
      export DISPLAY="$2"
      _DISPLAY_EXPLICIT=1
      shift 2
      ;;
    --xauthority)
      export XAUTHORITY="$2"
      _XAUTHORITY_EXPLICIT=1
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

# Prefer already-exported DISPLAY (from bin/start etc.).
# Only auto-detect when DISPLAY is completely unset.
if [ -z "${DISPLAY:-}" ] && [ -z "$_DISPLAY_EXPLICIT" ]; then
  _newest_sock=
  for _sock in /tmp/.X11-unix/X*; do
    [ -S "$_sock" ] || continue
    if [ -z "$_newest_sock" ] || [ "$_sock" -nt "$_newest_sock" ]; then
      _newest_sock=$_sock
    fi
  done
  if [ -n "$_newest_sock" ]; then
    _num="${_newest_sock##*/X}"
    export DISPLAY=":${_num}"
  fi
fi

# Prefer :10 (makamujo-xvfb) when available and nothing was forced
if [ -z "$_DISPLAY_EXPLICIT" ] && [ -S /tmp/.X11-unix/X10 ]; then
  export DISPLAY=:10
fi

if [ -n "${DISPLAY:-}" ] && [ -z "$_XAUTHORITY_EXPLICIT" ]; then
  _display_num="${DISPLAY#:}"
  _display_num="${_display_num%%.*}"
  _socket="/tmp/.X11-unix/X${_display_num}"
  if [ -S "$_socket" ]; then
    _owner=$(stat -c '%U' "$_socket" 2>/dev/null || true)
    if [ -n "$_owner" ]; then
      _home=$(getent passwd "$_owner" 2>/dev/null | cut -d: -f6 || true)
      if [ -n "$_home" ] && [ -f "${_home}/.Xauthority" ]; then
        export XAUTHORITY="${_home}/.Xauthority"
      fi
    fi
  fi
fi

"${OBS_STUDIO}" \
    --geometry 1280x560+0+900 \
    --startstreaming \
    --disable-shutdown-check \
    --disable-missing-files-check \
    --disable-updater \
    --disable-gpu \
    --disable-gpu-compositing \
    --in-process-gpu \
    --disable-gpu-sandbox \
    --no-sandbox \
    --disable-dev-shm-usage
